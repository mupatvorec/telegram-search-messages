# ─────────────────────────────────────────────
# Telegram Monitor Bot — конфигурация
# ─────────────────────────────────────────────

# 1. Получить на https://my.telegram.org → API Development Tools
API_ID=12345678
API_HASH=abcdef1234567890abcdef1234567890

# 2. Создать бота у @BotFather и скопировать токен
BOT_TOKEN=1234567890:AABBCCDDEEFFaabbccddeeff1234567890

# 3. Ваш Telegram ID (узнать у @userinfobot)
OWNER_ID=123456789

# 4. Имя файла сессии (можно не менять)
SESSION_NAME=monitor_session
